{
  "name": "affordable-gifts",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    // /admin and other pages are handled by the React app
    "not_found_handling": "single-page-application",
    // only API calls run the Worker; everything else is served straight from dist
    "run_worker_first": ["/api/*"]
  },
  // keep PUBLIC_API_BASE_URL as set in the dashboard instead of overwriting it on deploy
  "keep_vars": true
}
